{
  "name": "nokia-onebot-chat",
  "version": "0.1.0",
  "private": true,
  "description": "OneBot v11 chat web app targeting feature phones (Nokia 108) with no-JavaScript SSR",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@koa/router": "^15.7.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^9.0.0",
    "koa-session": "^7.0.2",
    "nunjucks": "^3.2.4",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-helmet": "^6.1.0",
    "@types/koa-session": "^6.4.5",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^26.4.0",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
