# OneBot v11 WebSocket 服务地址（默认 ws://127.0.0.1:3001）
ONEBOT_WS_URL=ws://127.0.0.1:3001

# Web 服务监听端口（默认 3000）
PORT=3000

# SQLite 数据库文件路径（默认 ./data/chat.db）
DB_PATH=./data/chat.db

# Cookie 签名密钥，多个用逗号分隔（生产环境务必改为随机值）
SESSION_KEYS=please-change-me-to-a-random-secret

# 生产 HTTPS 下设为 true，本地 HTTP 开发保持 false（默认 false）
COOKIE_SECURE=false

# 登录账号与密码（同时设置后启用登录鉴权；留空则禁用鉴权）
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-please

# 单条消息最大字符数（默认 4000）
MESSAGE_MAX_LENGTH=4000

# 内存中缓存的会话数 / 每个会话消息数上限（默认 100 / 100）
MAX_SESSIONS=100
MESSAGES_PER_SESSION=100

# OneBot API 调用超时（毫秒，默认 10000）
ONEBOT_API_TIMEOUT_MS=10000

# 连接超时 / 重连退避参数（默认值见下）
ONEBOT_CONNECT_TIMEOUT_MS=10000
ONEBOT_RECONNECT_MIN_DELAY_MS=1000
ONEBOT_RECONNECT_MAX_DELAY_MS=30000
ONEBOT_MAX_RECONNECT_ATTEMPTS=10

# 日志级别 debug|info|warn|error（默认 info）
LOG_LEVEL=info
